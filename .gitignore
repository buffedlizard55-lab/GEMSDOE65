/data/
/cache/
/runs/
/artifacts/
/registry/rasters/

# Local Python environments, bytecode, caches, and atomic-write scratch files.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.tmp
work/
.venv/
__pycache__/
*.pyc

