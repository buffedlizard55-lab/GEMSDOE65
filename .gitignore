# Keep local competition inputs, caches, runs, artifacts, and raster registry out of Git.
# `/data/` (a directory exclusion) would defeat the two negations at the end of this file,
# because git never descends into an excluded directory; `/data/*` ignores the same content
# while still allowing an explicit re-include.
/data/*
/cache/
/runs/
/artifacts/
/registry/rasters/

# Local Python environments, bytecode, caches, and atomic-write scratch files.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.tmp
work/
.venv/
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# lane65-sarprop: the second, independently developed lineage of this lane.
# Its large inputs and its model artifacts stay out of Git by design; the small
# text evidence and the dot list that rebuilds the submission do not.
# ---------------------------------------------------------------------------
lane65-sarprop/data/bridge/*.tif
lane65-sarprop/data/*.tif
lane65-sarprop/data/external/
lane65-sarprop/data/*.partial
lane65-sarprop/docs/downloads/*.tif
lane65-sarprop/docs/downloads/*.zip
lane65-sarprop/registry/cache/
lane65-sarprop/registry/rasters_cache/
lane65-sarprop/.pytest_cache/

# Derived arm-term caches (.npz): regenerated by scripts/run_lane.py; every number
# they hold is already in registry/holdout_arms*.json. The repository guard forbids
# tracked .npz/.npy artifacts.
/registry/*.npz

# ---------------------------------------------------------------------------
# lane65-sarprop: the second, independently developed lineage of this lane.
# Its large inputs and its model artifacts stay out of Git by design; the small
# text evidence and the dot list that rebuilds the submission do not.
# ---------------------------------------------------------------------------
lane65-sarprop/data/bridge/*.tif
lane65-sarprop/data/*.tif
lane65-sarprop/data/external/
lane65-sarprop/data/*.partial
lane65-sarprop/docs/downloads/*.tif
lane65-sarprop/docs/downloads/*.zip
lane65-sarprop/registry/cache/
lane65-sarprop/registry/rasters_cache/
lane65-sarprop/.pytest_cache/

# --- lane65-bandrf bridge grids (session arena/263a33f5) ---
# The pin-checked bridge grids are tracked on purpose: they are the two small inputs the
# shared grid loader requires, they are hash-recorded in evidence/lane65-bandrf/input_pins.json,
# and their size is bounded (2.0 MB).  The 419 MB feature stack stays out of Git.
/data/*
!/data/bridge/
!/data/bridge/*.tif

# --- lane65b additions (independent SAR-PU session 2026-10-11) ---
# this lane's derived caches and intermediate rasters are large and regenerable
.cache/
*.part-[0-9][0-9][0-9]
# official grid rasters are restored by scripts/00_restore_data.py (canonical) or
# scripts/_bootstrap.py; the repository guard forbids tracking *.tif outside the
# docs/downloads allowlist
data/bridge/*.tif
